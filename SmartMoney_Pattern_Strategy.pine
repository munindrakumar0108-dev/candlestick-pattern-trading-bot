//@version=5
strategy("Smart Money Candlestick + Pattern Strategy - LONG ONLY", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=1.0)

// ============================================
// INPUT PARAMETERS
// ============================================

bullish_patterns = input(true, "Enable Bullish Patterns", group="Patterns")
use_trend_filter = input(true, "Use Trend Filter", group="Trend Filter")
trend_ma_period = input.int(50, "Trend MA Period", minval=5, group="Trend Filter")
trend_type = input.string("EMA", "Trend Type", options=["SMA", "EMA"], group="Trend Filter")
use_volume_filter = input(true, "Use Volume Filter", group="Volume")
volume_ma_period = input.int(20, "Volume MA Period", minval=5, group="Volume")
volume_threshold = input.float(1.3, "Volume Threshold Multiplier", minval=1.0, group="Volume")
entry_lookback = input.int(30, "Swing Low/High Lookback", minval=10, group="Risk Management")
atr_multiplier = input.float(2.0, "ATR Multiplier for SL", minval=1.0, group="Risk Management")
tp1_multiplier = input.float(1.0, "TP1 Multiplier (1R)", minval=0.5, group="Risk Management")
tp2_multiplier = input.float(2.0, "TP2 Multiplier (2R)", minval=1.0, group="Risk Management")
tp3_multiplier = input.float(3.0, "TP3 Multiplier (3R)", minval=1.5, group="Risk Management")
partial_close_tp1 = input.float(50, "Close % at TP1", minval=10, maxval=100, group="Trade Management")
partial_close_tp2 = input.float(25, "Close % at TP2", minval=0, maxval=100, group="Trade Management")
show_fvg = input(true, "Show Fair Value Gaps", group="SMT Levels")
show_ob = input(true, "Show Order Blocks", group="SMT Levels")

// ============================================
// TREND FILTER
// ============================================

get_trend_ma() =>
    if trend_type == "SMA"
        ta.sma(close, trend_ma_period)
    else
        ta.ema(close, trend_ma_period)

trend_ma = get_trend_ma()
uptrend = close > trend_ma

// ============================================
// VOLUME FILTER
// ============================================

volume_ma = ta.sma(volume, volume_ma_period)
high_volume = volume > volume_ma * volume_threshold

// ============================================
// ATR FOR BETTER STOP LOSS
// ============================================

atr = ta.atr(14)

// ============================================
// CANDLESTICK PATTERN DETECTION - BULLISH ONLY
// ============================================

body_size = math.abs(close - open)
high_wick = high - math.max(close, open)
low_wick = math.min(close, open) - low

bullish_hammer = (close > open) and (body_size > (high - low) * 0.3) and (low_wick > body_size * 2) and (high_wick < body_size * 0.5)
bullish_engulfing = (close[1] < open[1]) and (open < close[1]) and (close > open[1]) and (body_size > (open[1] - close[1]))
bullish_piercing = (close[1] < open[1]) and (open < close[1]) and (close > (open[1] + close[1]) / 2) and (close < open[1] + (open[1] - close[1]) * 0.3)

morning_star_valid = (close[2] < open[2]) and (close[2] - open[2] < -((high[2] - low[2]) * 0.3)) and
                     (open[1] < close[2]) and ((high[1] - low[1]) < (high[2] - low[2]) * 0.6) and
                     (close > (open[0] + close[0]) / 2) and (close > open)

bullish_morning_star = morning_star_valid
bullish_3_white_soldiers = (close > open) and (close[1] > open[1]) and (close[2] > open[2]) and 
                           (close > close[1]) and (close[1] > close[2]) and (close - open > (high - low) * 0.3)

bullish_signal = bullish_hammer or bullish_engulfing or bullish_piercing or bullish_morning_star or bullish_3_white_soldiers

// ============================================
// SMART MONEY LEVELS - IMPROVED
// ============================================

fvg_bull = (low[1] > high[0]) and (close > low[1]) and (volume > volume_ma)
recent_swing_low = ta.lowest(low, entry_lookback)
ob_bull = (close > recent_swing_low) and (low == recent_swing_low) and (high > open)

// ============================================
// ENTRY & EXIT LEVELS - REFINED
// ============================================

swing_low = ta.lowest(low, entry_lookback)
swing_low_with_buffer = swing_low - (atr * atr_multiplier)

bullish_entry_price = close
bullish_sl = swing_low_with_buffer
bullish_risk = bullish_entry_price - bullish_sl
bullish_tp1 = bullish_entry_price + (bullish_risk * tp1_multiplier)
bullish_tp2 = bullish_entry_price + (bullish_risk * tp2_multiplier)
bullish_tp3 = bullish_entry_price + (bullish_risk * tp3_multiplier)

// ============================================
// ENTRY CONDITION - STRICT LONG ONLY
// ============================================

bullish_entry = bullish_patterns and bullish_signal and uptrend and high_volume and fvg_bull and (bullish_risk > 0)

// ============================================
// STRATEGY EXECUTION - LONG ONLY
// ============================================

var float entry_price = na
var float stop_loss = na
var float tp1 = na
var float tp2 = na
var float tp3 = na
var string trade_type = na
var int partial_closed_tp1 = 0
var int partial_closed_tp2 = 0
var string pattern_name = na
var int bars_in_trade = 0

if bullish_entry and strategy.position_size == 0
    entry_price := bullish_entry_price
    stop_loss := bullish_sl
    tp1 := bullish_tp1
    tp2 := bullish_tp2
    tp3 := bullish_tp3
    trade_type := "LONG"
    partial_closed_tp1 := 0
    partial_closed_tp2 := 0
    bars_in_trade := 0
    
    if bullish_hammer
        pattern_name := "HAMMER"
    else if bullish_engulfing
        pattern_name := "ENGULFING"
    else if bullish_piercing
        pattern_name := "PIERCING"
    else if bullish_morning_star
        pattern_name := "MORNING_STAR"
    else
        pattern_name := "3_WHITE_SOLDIERS"
    
    strategy.entry("BUY", strategy.long, comment=pattern_name + " SMT Signal")

if strategy.position_size != 0
    bars_in_trade := bars_in_trade + 1

if strategy.position_size != 0 and trade_type == "LONG"
    
    if close >= tp1 and partial_closed_tp1 == 0
        strategy.close("BUY", qty_percent=partial_close_tp1, comment="TP1 Hit 1R")
        partial_closed_tp1 := 1
        stop_loss := entry_price
    
    if close >= tp2 and partial_closed_tp2 == 0 and partial_closed_tp1 == 1
        strategy.close("BUY", qty_percent=partial_close_tp2, comment="TP2 Hit 2R")
        partial_closed_tp2 := 1
        stop_loss := tp1
    
    if close >= tp3
        strategy.close("BUY", comment="TP3 Hit WIN")
        bars_in_trade := 0
    
    if close <= stop_loss
        strategy.close("BUY", comment="SL HIT")
        bars_in_trade := 0
    
    if bars_in_trade > 200
        strategy.close("BUY", comment="Emergency Exit")
        bars_in_trade := 0

// ============================================
// VISUALIZATION WITH LABELS & LINES
// ============================================

if bullish_entry
    label.new(bar_index, high + (high - low) * 0.8, "ENTRY " + pattern_name, 
              yloc=yloc.abovebar, color=color.new(color.green, 20), textcolor=color.white, 
              style=label.style_label_down, size=size.small)

if strategy.position_size != 0
    line.new(bar_index - 1, entry_price, bar_index, entry_price, extend=extend.right, 
             color=color.blue, width=2, style=line.style_solid)
    
    line.new(bar_index - 1, stop_loss, bar_index, stop_loss, extend=extend.right, 
             color=color.red, width=2, style=line.style_dashed)
    
    line.new(bar_index - 1, tp1, bar_index, tp1, extend=extend.right, 
             color=color.new(color.green, 50), width=1, style=line.style_dotted)
    line.new(bar_index - 1, tp2, bar_index, tp2, extend=extend.right, 
             color=color.new(color.orange, 50), width=1, style=line.style_dotted)
    line.new(bar_index - 1, tp3, bar_index, tp3, extend=extend.right, 
             color=color.new(color.lime, 50), width=2, style=line.style_dotted)
    
    current_profit = close - entry_price
    label.new(bar_index, close, "P&L " + str.tostring(current_profit, "#.####"), 
              yloc=yloc.abovebar, color=color.new(color.gray, 50), 
              textcolor=color.white, style=label.style_label_lower, size=size.small)

bgcolor(bullish_signal and uptrend ? color.new(color.green, 85) : na)

// ============================================
// ALERTS FOR LIVE TRADING
// ============================================

if bullish_entry
    msg_entry = "LONG SIGNAL " + pattern_name + " Entry: " + str.tostring(entry_price, "#.####") + " SL: " + str.tostring(stop_loss, "#.####") + " TP1: " + str.tostring(tp1, "#.####") + " TP2: " + str.tostring(tp2, "#.####") + " TP3: " + str.tostring(tp3, "#.####")
    alert(msg_entry, alert.freq_once_per_bar_close)

if strategy.position_size != 0
    current_pnl = ((close - entry_price) / bullish_risk) * 100
    
    if bars_in_trade % 5 == 0
        msg_update = "UPDATE " + pattern_name + " Bar:" + str.tostring(bars_in_trade) + " P&L:" + str.tostring(current_pnl, "#.##") + "% Price:" + str.tostring(close, "#.####") + " Target TP1:" + str.tostring(tp1, "#.####")
        alert(msg_update, alert.freq_once_per_bar)

if strategy.position_size == 0 and bars_in_trade > 0 and close > entry_price
    msg_win = "WIN " + pattern_name + " Exit:" + str.tostring(close, "#.####") + " Profit:" + str.tostring(close - entry_price, "#.####")
    alert(msg_win, alert.freq_once_per_bar_close)
